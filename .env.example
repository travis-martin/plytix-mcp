# Leave empty until reuse of existing credentials is approved.
# Required for stdio; HTTP uses request headers instead.
PLYTIX_API_KEY=""
PLYTIX_API_PASSWORD=""
PLYTIX_WRITE_TOOLS='[]'
# Pricing drafts/rules: private local volume, or an existing approved GCS bucket.
# Bucket takes precedence and never falls back to the filesystem on an error.
# PLYTIX_PRICING_DIR=C:/private/plytix-pricing
# PLYTIX_PRICING_GCS_BUCKET=approved-private-bucket
# Optional operator-owned shared knowledge registry; never a client-supplied path.
# MCP_KNOWLEDGE_CONFIG=C:/private/plytix-knowledge/config.json
# Knowledge proposals have a separate allowlist and still require host approval.
# MCP_KNOWLEDGE_WRITE_TOOLS='["knowledge_propose"]'
# HTTP defaults to 127.0.0.1:8080 locally.
# HOST=127.0.0.1
# PORT=8080
# MCP_AUTH_TOKEN=""
# MCP_APPROVAL_SESSIONS=true
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# MCP_ALLOWED_ORIGINS=
# Optional account-specific labels (JSON arrays):
# PLYTIX_SEARCH_FIELDS='["sku","label","gtin"]'
# PLYTIX_MPN_LABELS='["attributes.mpn"]'
# PLYTIX_MNO_LABELS='["attributes.model_no"]'
