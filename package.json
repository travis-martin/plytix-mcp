{
  "name": "plytix-mcp",
  "version": "0.3.0",
  "type": "module",
  "description": "Read-only by default MCP tools for Plytix product data, schema, assets and relationships.",
  "keywords": [
    "mcp",
    "plytix",
    "pim",
    "product-information-management",
    "ai",
    "claude",
    "model-context-protocol"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "plytix-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http-main.ts",
    "build": "tsc",
    "start": "node dist/http-main.js",
    "start:stdio": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "npm run typecheck && npm run build && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "dotenv": "^16.4.5",
    "express": "5.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.3",
    "vitest": "^4.0.17"
  },
  "private": true
}
