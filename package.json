{
  "name": "plytix-mcp",
  "version": "0.11.0",
  "type": "module",
  "description": "Read-only by default MCP tools for Plytix product data, schema, assets and relationships.",
  "keywords": [
    "mcp",
    "plytix",
    "pim",
    "product-information-management",
    "ai",
    "claude",
    "model-context-protocol"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "plytix-mcp": "dist/index.js",
    "plytix-knowledge-admin": "dist/knowledge/admin.js"
  },
  "files": [
    "dist/",
    "README.md",
    "docs/knowledge.md",
    "docs/security.md",
    "docs/api-coverage.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http-main.ts",
    "build": "tsc && node scripts/build-ui.mjs",
    "plugin:build": "node scripts/plugin-build.mjs",
    "plugin:check": "node scripts/plugin-check.mjs",
    "plugin:test": "node scripts/plugin-test.mjs",
    "plugin:prepare-local": "node scripts/plugin-prepare-local.mjs",
    "start": "node dist/http-main.js",
    "start:stdio": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live:read": "npm run build && node scripts/live-read-smoke.mjs",
    "test:all": "npm run typecheck && npm run build && npm test",
    "knowledge:admin": "tsx src/knowledge/admin.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google-cloud/storage": "8.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.4.5",
    "express": "5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.7.0",
    "typescript": "^5.6.3",
    "vitest": "^4.0.17"
  },
  "private": true
}
